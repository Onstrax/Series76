# Series 76 Technical Assistant — environment template for docker compose.
# Copy to .env (cp .env.example .env) and replace every CHANGE_ME locally.
# NEVER commit a real .env. Every value here is a NON-FUNCTIONAL PLACEHOLDER.

# ---- Local compose database (owner account; used only by the one-shot `migrate` job) ----
POSTGRES_PASSWORD=CHANGE_ME_local_db_owner_password

# ---- Application database login (created + granted by `migrate`) ----
# The api/worker connect as this least-privilege user (app_writer + runtime_reader_role).
# Host `db` inside compose; use localhost:5432 when running the backend outside compose.
DATABASE_URL=postgresql+psycopg://series76_app:CHANGE_ME_app_password@db:5432/series76
# Optional: separate URL for catalog reads (defaults to DATABASE_URL).
CATALOG_DATABASE_URL=

# ---- Encryption (Spec 3): AES-256-GCM, envelope keys ----
# Key-Encryption-Key held OUTSIDE the database: base64 of 32 random bytes.
# Generate locally with:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEK=CHANGE_ME_base64_of_32_random_bytes

# ---- Auth (Spec 3) ----
AUTH_TOKEN_POLICY=opaque-sha256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# ---- Agent runtime (Spec 4) ----
# fake         = deterministic zero-spend seam (default; no model, no key).
# orchestrator = the real agent (needs OPENROUTER_API_KEY + AGENT_MODEL + MODEL_CAPABILITIES).
AGENT_RUNTIME=fake
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# deny (default) = only providers that do not retain/train on prompts.
OPENROUTER_DATA_COLLECTION=deny
# No model id is hardcoded in code: choose them here. At least two candidates per
# function (comma-separated) are needed for the cost-gated A/B evaluation.
AGENT_MODEL=CHANGE_ME_tool_calling_model_id
AGENT_MODEL_CANDIDATES=
INTERPRETER_MODEL=
INTERPRETER_MODEL_CANDIDATES=
ANSWER_MODEL=
ANSWER_MODEL_CANDIDATES=
FALLBACK_MODEL=
# Verified endpoint capabilities, JSON: {"<model id>": ["tools", "json_schema"]}.
# A model without verified capabilities is refused (fail closed), never guessed.
MODEL_CAPABILITIES={}
# Optional: pin a model to exact OpenRouter providers (provider.only), JSON
# {"<model id>": ["provider", ...]}. Capabilities are then verified on those
# endpoints alone. `python -m series76_eval probe-models` prints MODEL_CAPABILITIES.
MODEL_PROVIDERS={}
# Tool set exposed to the agent: A (coarse) | B (fine-grained, default).
AGENT_TOOL_SET=B

# ---- Budget (Spec 4 / Spec 6) ----
# The USD 10 hard cap, USD 6 dev/eval cap and USD 4 demo reserve are fixed in code
# (CostLedger) and cannot be raised by configuration.
# DEV_EVAL while developing/evaluating; DEMO only for the final demo.
SPEND_CATEGORY=DEV_EVAL
# Conservative pre-call estimate used to authorize each model call.
MODEL_CALL_ESTIMATE_USD=0.01
# Per-turn rails.
TURN_MAX_COST_USD=0.05
TURN_MAX_WALLTIME_S=60
TURN_BUDGET_USD=0.50
TURN_TIMEOUT_SECONDS=120

# ---- Queue / job leases (Spec 3) ----
PENDING_JOB_CAP=5
JOB_LEASE_SECONDS_MIN=30
JOB_LEASE_SECONDS_MAX=120

# ---- Ingestion (Spec 1) ----
# verified_replay (the default mode) needs NO key. fresh_extraction is optional and
# needs the evaluator's own GEMINI_API_KEY (see README, "Ingestion modes").
GEMINI_API_KEY=

# ---- Seed CLI (optional demo accounts; never committed) ----
SEED_PASSWORD=
