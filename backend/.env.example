# Series 76 Technical Assistant — environment template.
# Copy to .env and fill in real values locally. NEVER commit a real .env.
# Every value here is a NON-FUNCTIONAL PLACEHOLDER.

# ---- Database (Spec 1 / Spec 3) ----
# Full connection URL used by the application runtime (least-privilege reader).
DATABASE_URL=postgresql+psycopg://series76_app:CHANGE_ME@localhost:5432/series76
# Privileged URLs used only by migrations / ingestion / publication tooling.
INGEST_DATABASE_URL=postgresql+psycopg://series76_ingest:CHANGE_ME@localhost:5432/series76
PUBLISH_DATABASE_URL=postgresql+psycopg://series76_publisher:CHANGE_ME@localhost:5432/series76

# ---- Ingestion (Spec 1) ----
# Required ONLY for fresh_extraction mode. verified_replay (the default) needs no key.
GEMINI_API_KEY=
# Ingestion run mode: verified_replay (default, reproducible) | fresh_extraction
INGESTION_MODE=verified_replay

# ---- Crypto (Spec 3) ----
# The Key-Encryption-Key is held OUTSIDE the database. In production this comes
# from a KMS/secret manager; locally, a base64-encoded 32-byte value.
KEK_BASE64=CHANGE_ME_base64_of_32_random_bytes

# ---- Agent / LLM (Spec 4) ----
# Provider-agnostic; OpenRouter-compatible. No model id is hardcoded in code.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=CHANGE_ME_model_id
INTERPRETER_MODEL=
ANSWER_MODEL=
FALLBACK_MODEL=
# Hard budget rails (Spec 6). USD.
EVAL_BUDGET_CAP_USD=10.00
EVAL_DEV_CAP_USD=6.00
EVAL_DEMO_RESERVE_USD=4.00
