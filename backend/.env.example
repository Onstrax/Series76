# Series 76 Technical Assistant — environment template for docker compose.
# Copy to .env (cp .env.example .env), replace every CHANGE_ME and paste your
# OpenRouter key. NEVER commit a real .env. Secrets here are placeholders; the model
# ids are the ones selected by the A/B evaluation and the demo users are local-only.

# ---- Local compose database (owner account; used only by the one-shot `migrate` job) ----
POSTGRES_PASSWORD=CHANGE_ME_local_db_owner_password

# ---- Application database login (created + granted by `migrate`) ----
# The api/worker connect as this least-privilege user (app_writer + runtime_reader_role).
# Host `db` inside compose; use localhost:5432 when running the backend outside compose.
DATABASE_URL=postgresql+psycopg://series76_app:CHANGE_ME_app_password@db:5432/series76
# Optional: separate URL for catalog reads (defaults to DATABASE_URL).
CATALOG_DATABASE_URL=

# ---- Encryption (Spec 3): AES-256-GCM, envelope keys ----
# Key-Encryption-Key held OUTSIDE the database: base64 of 32 random bytes.
# Generate locally with:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEK=CHANGE_ME_base64_of_32_random_bytes

# ---- Auth (Spec 3) ----
AUTH_TOKEN_POLICY=opaque-sha256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# ---- Agent runtime (Spec 4) ----
# orchestrator = the real agent (needs OPENROUTER_API_KEY; without it every turn ends
#                with an explained "could not answer" reply, never an invented one).
# fake         = deterministic zero-spend seam (no model, no key) for local smoke tests.
AGENT_RUNTIME=orchestrator
OPENROUTER_API_KEY=CHANGE_ME_your_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# deny (default) = only providers that do not retain/train on prompts.
OPENROUTER_DATA_COLLECTION=deny
# No model id is hardcoded in code. These are the models selected by the paired A/B
# evaluation (README, "Model choice"); change them freely. The *_CANDIDATES lists are
# what `python -m series76_eval ab-live` compares.
AGENT_MODEL=deepseek/deepseek-v4-flash
AGENT_MODEL_CANDIDATES=openai/gpt-oss-120b,deepseek/deepseek-v4-flash,google/gemini-2.5-flash-lite
INTERPRETER_MODEL=openai/gpt-oss-120b
INTERPRETER_MODEL_CANDIDATES=openai/gpt-oss-120b,deepseek/deepseek-v4-flash,google/gemini-2.5-flash-lite
# Accepted but unused: answers are composed deterministically (no model writes numbers).
ANSWER_MODEL=
ANSWER_MODEL_CANDIDATES=
# Used only if it preserves the required capabilities and privacy setting.
FALLBACK_MODEL=openai/gpt-4.1-mini
# Verified endpoint capabilities, JSON {"<model id>": ["tools", "structured_outputs"]}.
# A model without verified capabilities is refused (fail closed), never guessed.
# Regenerate with `python -m series76_eval probe-models` (public endpoint list, no key).
MODEL_CAPABILITIES={"openai/gpt-oss-120b":["structured_outputs","tools"],"deepseek/deepseek-v4-flash":["structured_outputs","tools"],"google/gemini-2.5-flash-lite":["structured_outputs","tools"],"openai/gpt-4.1-mini":["structured_outputs","tools"]}
# Pin a model to exact OpenRouter providers (provider.only); capabilities are then
# verified on those endpoints alone. gpt-oss-120b has providers without tool support.
MODEL_PROVIDERS={"openai/gpt-oss-120b":["groq","cerebras","together","deepinfra"]}
# Tool set exposed to the agent: A (coarse) | B (fine-grained, default).
AGENT_TOOL_SET=B

# ---- Budget (Spec 4 / Spec 6) ----
# The USD 10 hard cap, USD 6 dev/eval cap and USD 4 demo reserve are fixed in code
# (CostLedger) and cannot be raised by configuration.
# DEV_EVAL while developing/evaluating; DEMO only for the final demo.
SPEND_CATEGORY=DEV_EVAL
# Conservative pre-call estimate used to authorize each model call.
MODEL_CALL_ESTIMATE_USD=0.01
# Per-turn rails.
TURN_MAX_COST_USD=0.05
TURN_MAX_WALLTIME_S=60
TURN_BUDGET_USD=0.50
TURN_TIMEOUT_SECONDS=120

# ---- Queue / job leases (Spec 3) ----
PENDING_JOB_CAP=5
JOB_LEASE_SECONDS_MIN=30
JOB_LEASE_SECONDS_MAX=120

# ---- Ingestion (Spec 1) ----
# verified_replay (the default mode) needs NO key. fresh_extraction is optional and
# needs the evaluator's own GEMINI_API_KEY (see README, "Ingestion modes").
GEMINI_API_KEY=

# ---- Pre-loaded test users (assessment section 7) ----
# The Compose `migrate` job creates these two accounts on every start (idempotent).
# They are LOCAL DEMO credentials, documented in the README; change them (or leave
# the passwords empty to disable the accounts) for anything that is not a local demo.
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=demo-user-example-2026A!
DEMO_DEVELOPER_EMAIL=dev@example.com
DEMO_DEVELOPER_PASSWORD=demo-dev-example-2026A!

# ---- Seed CLI (extra accounts, out of band) ----
SEED_PASSWORD=
