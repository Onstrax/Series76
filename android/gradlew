#!/bin/sh
# Minimal POSIX launcher for the Gradle wrapper (Gradle 8.10.2).
# The wrapper JAR is the official one (SHA-256 2db75c40782f5e8ba1fc278a5574bab070adccb2d21ca5a6e5ed840888448046);
# it downloads the distribution pinned (and checksum-verified) in gradle/wrapper/gradle-wrapper.properties.
APP_HOME=$(cd "$(dirname "$0")" && pwd -P) || exit 1
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD=java
fi
if ! command -v "$JAVACMD" >/dev/null 2>&1; then
  echo "ERROR: Java not found. Set JAVA_HOME to a JDK 17 installation." >&2
  exit 1
fi
exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
  "-Dorg.gradle.appname=gradlew" -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain "$@"
